<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE excels PUBLIC "-//PAOHAIJIAO//DTD API EXCEL 1.0//EN"
        "classpath:paohaijiao/dtd/Jquick-excel.dtd">
<!--
  mapping 子包：MAPPING —— 源字段与表头文本的双向映射。
  导出方向：源字段 -> 表头文本；导入方向：Excel 表头 -> Java 字段（方向相反）。
-->
<excels namespace="com.github.paohaijiao.demo.mapping.MappingService">

    <excel name="exportMapping" returnClass="void">
        <![CDATA[
            EXPORT WITH SHEET="字段映射", HEADER=true,
                MAPPING={"a":"姓名","b":"年龄","c":"班级"}
        ]]>
    </excel>

    <excel name="importMapping" returnClass="java.util.List">
        <![CDATA[
            IMPORT WITH SHEET="学生信息", HEADER=true,
                MAPPING={"学号":"no","姓名":"name","性别":"sex","年龄":"age","出生日期":"birthday","班级":"className"}
        ]]>
    </excel>

</excels>
