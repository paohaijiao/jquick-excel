<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE excels PUBLIC "-//PAOHAIJIAO//DTD API EXCEL 1.0//EN"
        "classpath:paohaijiao/dtd/Jquick-excel.dtd">
<!--
  footer 子包：FOOTER 页脚（固定文本）。
  注意：FOOTER 不会对 ${...} 做插值，写 ${current_date()} 会原样输出；
  需要动态页脚请在 Java 侧拼好字符串后 model.setFooter(...)（见 FooterDemo）。
-->
<excels namespace="com.github.paohaijiao.demo.footer.FooterService">

    <excel name="exportFooterFixed" returnClass="void">
        <![CDATA[
            EXPORT WITH SHEET="页脚", HEADER=true, MAPPING={"a":"姓名","b":"年龄"},
                FOOTER="Generated by JQuickExcel"
        ]]>
    </excel>

</excels>
